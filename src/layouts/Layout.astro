---
import '../styles/global.css';
import { withBase } from '../utils/url';

export interface Props {
  title?: string;
  description?: string;
}

const { title = 'Liri — 你的 AI 私人助手', description = 'Liri（玲珑鸟）是开源（MIT）的终端 AI 智能体：82 个内置工具、27 个消息渠道、五层安全防线，支持本地模型与多供应商路由。' } = Astro.props;

const siteOrigin = Astro.site?.origin ?? 'https://openliri.com';
const ogImage = new URL(withBase('/logo-512.png'), siteOrigin).href;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="keywords" content="Liri,玲珑鸟,AI 助手,AI Agent,终端助手,开源,TypeScript,Rust,MCP,消息渠道" />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={new URL(withBase('/'), siteOrigin).href} />
    <meta property="og:image" content={ogImage} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <link rel="icon" href={withBase('/favicon.ico')} sizes="any" />
    <link rel="icon" type="image/png" href={withBase('/logo.png')} />
    <link rel="apple-touch-icon" href={withBase('/logo-512.png')} />

    <title>{title}</title>
  </head>
  <body class="min-h-screen">
    <slot />
  </body>
</html>
