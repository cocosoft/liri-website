---
import '../styles/global.css';
import { withBase } from '../utils/url';
import { isIterating } from '../data/site';
import { HTML_LANG, LOCALES, getLangFromUrl, pick, switchLangPath } from '../i18n';
import { ui } from '../i18n/ui';
import StageBanner from '../components/StageBanner.astro';

export interface Props {
  title?: string;
  description?: string;
}

const lang = getLangFromUrl(Astro.url);
const t = pick(ui, Astro.url);
const {
  title = t.meta.homeTitle,
  description = t.meta.homeDescription,
} = Astro.props;

const siteOrigin = Astro.site?.origin ?? 'https://openliri.com';
const ogImage = new URL(withBase('/logo-512.png'), siteOrigin).href;
const canonical = new URL(Astro.url.pathname, siteOrigin).href;
const alternates = LOCALES.map((l) => ({
  hreflang: HTML_LANG[l],
  href: new URL(switchLangPath(Astro.url, l), siteOrigin).href,
}));
---

<!doctype html>
<html lang={HTML_LANG[lang]}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="keywords" content="Liri,玲珑鸟,AI 助手,AI Agent,终端助手,开源,TypeScript,Rust,MCP,消息渠道" />
    <!-- Google Search Console 验证（DNS TXT 的兜底方案，content 为 TXT 值中 = 之后的部分） -->
    <meta name="google-site-verification" content="YLEkX6K5Toa8hZk-EROkIEH_03xktM3fQa4hOpKQBX4" />

    <link rel="canonical" href={canonical} />
    {alternates.map((alt) => (
      <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />
    ))}
    <link rel="alternate" hreflang="x-default" href={alternates[0].href} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={lang === 'zh' ? 'zh_CN' : 'en_US'} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <link rel="icon" href={withBase('/favicon.ico')} sizes="any" />
    <link rel="icon" type="image/png" href={withBase('/logo.png')} />
    <link rel="apple-touch-icon" href={withBase('/logo-512.png')} />

    <title>{title}</title>
  </head>
  <body id="top" class={`min-h-screen ${isIterating ? 'pt-9' : ''}`}>
    {isIterating && <StageBanner />}
    <slot />
  </body>
</html>
