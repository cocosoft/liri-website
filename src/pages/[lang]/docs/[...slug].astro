---
import DocsArticle from '../../../components/docs/DocsArticle.astro';
import { getCollection, render } from 'astro:content';
import { PREFIXED_LOCALES } from '../../../i18n';

export async function getStaticPaths() {
  const docs = await getCollection('docsEn');
  return PREFIXED_LOCALES.flatMap((lang) =>
    docs.map((entry) => ({
      params: { lang, slug: entry.id },
      props: { entry },
    })),
  );
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const pages = (await getCollection('docsEn')).sort((a, b) => a.data.order - b.data.order);
---

<DocsArticle entry={entry} pages={pages} Content={Content} />
