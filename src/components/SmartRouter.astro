---
import { siteFacts } from '../data/site';
import { fmt, pick } from '../i18n';
import { smartRouter } from '../i18n/sections/smartRouter';

const c = pick(smartRouter, Astro.url);

// 任务类型数据
const taskTypes = [
  { icon: '💻', color: 'text-green-400' },
  { icon: '✍️', color: 'text-blue-400' },
  { icon: '📊', color: 'text-purple-400' },
  { icon: '🔧', color: 'text-amber-400' },
  { icon: '🌐', color: 'text-cyan-400' },
  { icon: '🔍', color: 'text-rose-400' },
  { icon: '🎨', color: 'text-pink-400' },
  { icon: '💬', color: 'text-surface-400' },
];

// 决策层数据（真实实现：SmartRouter 的五段判定）
const layers = [
  { color: 'bg-green-500/10 border-green-500/20' },
  { color: 'bg-brand-500/10 border-brand-500/20' },
  { color: 'bg-cyan-500/10 border-cyan-500/20' },
  { color: 'bg-amber-500/10 border-amber-500/20' },
  { color: 'bg-purple-500/10 border-purple-500/20' },
];

// 回退链数据（与具体模型名解耦，按供应商顺序回退）
const fallbackChain = [
  { status: 'primary' },
  { status: 'fallback' },
  { status: 'fallback' },
  { status: 'fallback' },
  { status: 'fallback' },
];
---

<section id="smart-router" class="section-padding relative overflow-hidden">
  <div class="absolute inset-0 bg-gradient-to-b from-surface-950 via-surface-975 to-surface-950 pointer-events-none"></div>
  <div class="absolute top-1/3 left-1/2 -translate-x-1/2 w-[500px] h-[500px] bg-brand-500/3 blur-3xl rounded-full pointer-events-none"></div>

  <div class="section-container relative z-10">
    <h2 class="text-3xl sm:text-4xl font-bold text-center mb-4">
      <span class="gradient-text">{c.title}</span>
    </h2>
    <p class="text-surface-400 text-center mb-12 max-w-3xl mx-auto">
      {c.subtitle}
    </p>

    <!-- 任务类型 -->
    <div class="max-w-4xl mx-auto mb-12">
      <h3 class="text-sm font-mono text-surface-500 text-center mb-5">
        {fmt(c.taskTypesHeading, { taskTypes: siteFacts.taskTypes, common: taskTypes.length })}
      </h3>
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
        {taskTypes.map((t, i) => (
          <div class="glass-card p-4 text-center hover:border-brand-500/30 transition-all duration-300">
            <div class="text-2xl mb-1">{t.icon}</div>
            <div class={`text-sm font-semibold ${t.color}`}>{c.taskTypes[i].name}</div>
            <div class="text-xs text-surface-500 mt-1">{c.taskTypes[i].desc}</div>
          </div>
        ))}
      </div>
    </div>

    <!-- 5 层决策管线 -->
    <div class="max-w-3xl mx-auto mb-12">
      <h3 class="text-sm font-mono text-surface-500 text-center mb-5">
        {fmt(c.layersHeading, { n: layers.length })}
      </h3>
      <div class="space-y-2">
        {layers.map((layer, i) => (
          <div>
            <div class={`p-4 rounded-xl ${layer.color} border`}>
              <div class="flex items-center gap-3">
                <span class="text-xs font-mono text-surface-500 bg-surface-800/60 px-2 py-0.5 rounded">{i + 1}</span>
                <span class="text-sm font-semibold text-surface-200">{c.layers[i].name}</span>
                <span class="text-xs text-surface-500 ml-auto">{c.layers[i].desc}</span>
              </div>
            </div>
            {i < layers.length - 1 && (
              <div class="flex justify-center py-1">
                <svg class="w-3 h-3 text-surface-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19 14l-7 7m0 0l-7-7" />
                </svg>
              </div>
            )}
          </div>
        ))}
      </div>
    </div>

    <!-- 供应商回退链 -->
    <div class="max-w-3xl mx-auto glass-card p-5 sm:p-6 border-amber-500/20">
      <h3 class="text-sm font-mono text-surface-500 text-center mb-4">{c.fallbackHeading}</h3>
      <p class="text-surface-400 text-xs text-center mb-4">{c.fallbackNote}</p>
      <!-- 桌面端：横向排列 -->
      <div class="hidden sm:flex flex-wrap items-center justify-center gap-2">
        {fallbackChain.map((f, i) => (
          <>
            <div class={`px-4 py-2 rounded-xl text-sm font-mono ${
              f.status === 'primary'
                ? 'bg-brand-500/10 border border-brand-500/20 text-brand-300'
                : 'bg-surface-800/40 border border-surface-800/50 text-surface-400'
            }`}>
              {c.fallback[i].model}
            </div>
            {i < fallbackChain.length - 1 && (
              <svg class="w-4 h-4 text-surface-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
              </svg>
            )}
          </>
        ))}
      </div>
      <!-- 移动端：纵向排列 -->
      <div class="sm:hidden space-y-2">
        {fallbackChain.map((f, i) => (
          <div class="flex items-center gap-2">
            {i > 0 && (
              <svg class="w-3 h-3 text-surface-600 shrink-0 -ml-0.5 rotate-90" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 14l-7 7m0 0l-7-7" />
              </svg>
            )}
            <div class={`flex-1 px-4 py-2 rounded-xl text-sm font-mono ${
              f.status === 'primary'
                ? 'bg-brand-500/10 border border-brand-500/20 text-brand-300'
                : 'bg-surface-800/40 border border-surface-800/50 text-surface-400'
            }`}>
              <span class="text-xs text-surface-500 mr-2 font-mono">{c.fallback[i].name}</span>
              {c.fallback[i].model}
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
