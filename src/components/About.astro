---
import { siteFacts } from '../data/site';
import { fmt, num, pick } from '../i18n';
import { about } from '../i18n/sections/about';

const c = pick(about, Astro.url);
const statValues = [
  num(siteFacts.tsFiles),
  siteFacts.tools,
  siteFacts.channels,
  siteFacts.desktopComponents,
];

// 每个数字都能点回源码，避免「说了但不好验证」
const repo = 'https://github.com/cocosoft/Liri';
const statSources = [
  `${repo}/tree/main/app/src`,
  `${repo}/blob/main/app/src/constants/toolNames.generated.ts`,
  `${repo}/blob/main/app/src/channels/ChannelCatalog.ts`,
  `${repo}/tree/main/client/src`,
];
---

<section class="section-padding relative">
  <div class="section-container">
    <div class="max-w-4xl mx-auto">
      <!-- 区块标题 -->
      <h2 class="text-3xl sm:text-4xl font-bold text-center mb-16">
        <span class="gradient-text">{c.title}</span>
      </h2>

      <!-- 核心描述 -->
      <div class="space-y-6 text-surface-300 text-base sm:text-lg leading-relaxed">
        <p class="glass-card p-8 text-center">
          <Fragment set:html={c.p1} />
        </p>

        <p class="glass-card p-8 text-center">
          <Fragment set:html={c.p2} />
        </p>

        <p class="glass-card p-8 text-center">
          <Fragment
            set:html={fmt(c.p3, {
              modules: siteFacts.modules,
              tsFiles: num(siteFacts.tsFiles),
              desktopComponents: siteFacts.desktopComponents,
            })}
          />
        </p>
      </div>

      <!-- 关键数据统计：点击可跳到源码核对 -->
      <div class="mt-16 grid grid-cols-2 sm:grid-cols-4 gap-4">
        {statValues.map((value, i) => (
          <a
            href={statSources[i]}
            target="_blank"
            rel="noopener noreferrer"
            title={c.verifyTitle}
            class="glass-card p-6 text-center group hover:border-brand-500/30 transition-colors"
          >
            <div class="text-3xl font-bold gradient-text mb-1">{value}</div>
            <div class="text-surface-400 text-sm inline-flex items-center gap-1">
              {c.statLabels[i]}
              <svg class="w-3 h-3 opacity-0 group-hover:opacity-100 transition-opacity" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            </div>
          </a>
        ))}
      </div>
    </div>
  </div>
</section>
