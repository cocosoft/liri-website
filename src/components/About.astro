---
import { siteFacts } from '../data/site';
import { fmt, num, pick } from '../i18n';
import { about } from '../i18n/sections/about';

const c = pick(about, Astro.url);
const statValues = [
  num(siteFacts.tsFiles),
  siteFacts.tools,
  siteFacts.channels,
  siteFacts.desktopComponents,
];
---

<section class="section-padding relative">
  <div class="section-container">
    <div class="max-w-4xl mx-auto">
      <!-- 区块标题 -->
      <h2 class="text-3xl sm:text-4xl font-bold text-center mb-16">
        <span class="gradient-text">{c.title}</span>
      </h2>

      <!-- 核心描述 -->
      <div class="space-y-6 text-surface-300 text-base sm:text-lg leading-relaxed">
        <p class="glass-card p-8 text-center">
          <Fragment set:html={c.p1} />
        </p>

        <p class="glass-card p-8 text-center">
          <Fragment set:html={c.p2} />
        </p>

        <p class="glass-card p-8 text-center">
          <Fragment
            set:html={fmt(c.p3, {
              modules: siteFacts.modules,
              tsFiles: num(siteFacts.tsFiles),
              desktopComponents: siteFacts.desktopComponents,
            })}
          />
        </p>
      </div>

      <!-- 关键数据统计 -->
      <div class="mt-16 grid grid-cols-2 sm:grid-cols-4 gap-4">
        {statValues.map((value, i) => (
          <div class="glass-card p-6 text-center">
            <div class="text-3xl font-bold gradient-text mb-1">{value}</div>
            <div class="text-surface-400 text-sm">{c.statLabels[i]}</div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
