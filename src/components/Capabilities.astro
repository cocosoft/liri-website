---
import { siteFacts } from '../data/site';
import { fmt, pick } from '../i18n';
import { capabilities } from '../i18n/sections/capabilities';

const c = pick(capabilities, Astro.url);

// 卡片图标（顺序与文案数组一致）
const icons = ['🧠', '🛡️', '🛠️', '🌐', '📊', '🔌', '🏠', '🚦'];

// 数字事实统一取自 siteFacts，文案中以 {name} 占位
const nums = {
  tools: siteFacts.tools,
  categories: siteFacts.toolCategories,
  channels: siteFacts.channels,
  strategies: siteFacts.agentStrategies,
  dangerousRules: siteFacts.dangerousRules,
  injectionRules: siteFacts.injectionRules,
  taskTypes: siteFacts.taskTypes,
};
---

<section id="capabilities" class="section-padding relative">
  <!-- 背景装饰 -->
  <div class="absolute inset-0 bg-gradient-to-b from-surface-950 via-surface-975 to-surface-950 pointer-events-none"></div>

  <div class="section-container relative z-10">
    <h2 class="text-3xl sm:text-4xl font-bold text-center mb-4">
      <span class="gradient-text">{c.title}</span>
    </h2>
    <p class="text-surface-400 text-center mb-16 max-w-2xl mx-auto">
      {c.subtitle}
    </p>

    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-5">
      {c.items.map((cap, index) => (
        <div
          class="glass-card p-6 group hover:border-brand-500/30 transition-all duration-500 hover:-translate-y-1 glow"
          style={`animation: fade-in-up .6s ease-out ${index * 0.1}s both;`}
        >
          <div class="flex items-center justify-between mb-4">
            <div class="text-3xl group-hover:scale-110 transition-transform duration-300">{icons[index]}</div>
            <span class="px-2.5 py-0.5 rounded-full text-xs font-mono bg-brand-500/10 text-brand-400 border border-brand-500/20">
              {cap.highlight}
            </span>
          </div>
          <h3 class="text-lg font-bold text-surface-100 mb-2">{fmt(cap.title, nums)}</h3>
          <p class="text-surface-400 text-sm mb-4 leading-relaxed">{fmt(cap.description, nums)}</p>
          <ul class="space-y-1.5">
            {cap.details.map((detail) => (
              <li class="flex items-center gap-2 text-sm text-surface-500">
                <svg class="w-3.5 h-3.5 text-brand-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                </svg>
                {fmt(detail, nums)}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>