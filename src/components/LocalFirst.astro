---
import { siteFacts } from '../data/site';
import { fmt, pick } from '../i18n';
import { localFirst } from '../i18n/sections/localFirst';

const c = pick(localFirst, Astro.url);
---

<section id="local-first" class="section-padding relative overflow-hidden">
  <div class="absolute inset-0 bg-gradient-to-b from-surface-950 via-surface-975 to-surface-950 pointer-events-none"></div>
  <div class="absolute top-1/3 left-0 w-72 h-72 bg-green-500/5 blur-3xl rounded-full pointer-events-none"></div>

  <div class="section-container relative z-10">
    <h2 class="text-3xl sm:text-4xl font-bold text-center mb-4">
      <span class="gradient-text">{c.title}</span>
    </h2>
    <p class="text-surface-400 text-center mb-12 max-w-3xl mx-auto">
      {c.subtitle}
    </p>

    <div class="grid md:grid-cols-2 gap-8 max-w-5xl mx-auto">
      <!-- 本地优先优势 -->
      <div class="space-y-4">
        <div class="glass-card p-6 border-green-500/20">
          <div class="flex items-center gap-3 mb-3">
            <span class="text-2xl">🏠</span>
            <h3 class="text-lg font-bold text-surface-100">{c.benefits[0].title}</h3>
          </div>
          <p class="text-surface-400 text-sm leading-relaxed">
            {c.benefits[0].desc}
          </p>
        </div>

        <div class="glass-card p-6 border-green-500/20">
          <div class="flex items-center gap-3 mb-3">
            <span class="text-2xl">🔒</span>
            <h3 class="text-lg font-bold text-surface-100">{c.benefits[1].title}</h3>
          </div>
          <p class="text-surface-400 text-sm leading-relaxed">
            {c.benefits[1].desc}
          </p>
        </div>

        <div class="glass-card p-6 border-green-500/20">
          <div class="flex items-center gap-3 mb-3">
            <span class="text-2xl">🌐</span>
            <h3 class="text-lg font-bold text-surface-100">{c.benefits[2].title}</h3>
          </div>
          <p class="text-surface-400 text-sm leading-relaxed">
            {fmt(c.benefits[2].desc, { providers: siteFacts.llmProviders })}
          </p>
        </div>
      </div>

      <!-- 两种模式对照 -->
      <div class="glass-card p-6">
        <h3 class="text-lg font-bold text-surface-100 mb-4 text-center">{c.compareTitle}</h3>
        <div class="space-y-3">
          <div class="p-3 rounded-xl bg-surface-800/40 border border-surface-800/50">
            <div class="flex items-center justify-between text-xs mb-1">
              <span class="text-surface-400">{c.compareRows[0].label}</span>
            </div>
            <div class="flex items-center justify-between gap-3 text-xs">
              <span class="text-green-400 font-semibold">{c.compareRows[0].local}</span>
              <span class="text-brand-400">{c.compareRows[0].cloud}</span>
            </div>
          </div>
          <div class="p-3 rounded-xl bg-surface-800/40 border border-surface-800/50">
            <div class="flex items-center justify-between text-xs mb-1">
              <span class="text-surface-400">{c.compareRows[1].label}</span>
            </div>
            <div class="flex items-center justify-between gap-3 text-xs">
              <span class="text-green-400 font-semibold">{c.compareRows[1].local}</span>
              <span class="text-brand-400">{c.compareRows[1].cloud}</span>
            </div>
          </div>
          <div class="p-3 rounded-xl bg-surface-800/40 border border-surface-800/50">
            <div class="flex items-center justify-between text-xs mb-1">
              <span class="text-surface-400">{c.compareRows[2].label}</span>
            </div>
            <div class="flex items-center justify-between gap-3 text-xs">
              <span class="text-green-400 font-semibold">{c.compareRows[2].local}</span>
              <span class="text-brand-400">{c.compareRows[2].cloud}</span>
            </div>
          </div>
          <div class="p-3 rounded-xl bg-surface-800/40 border border-surface-800/50">
            <div class="flex items-center justify-between text-xs mb-1">
              <span class="text-surface-400">{c.compareRows[3].label}</span>
            </div>
            <div class="flex items-center justify-between gap-3 text-xs">
              <span class="text-green-400 font-semibold">{c.compareRows[3].local}</span>
              <span class="text-brand-400">{c.compareRows[3].cloud}</span>
            </div>
          </div>
          <div class="p-3 rounded-xl bg-surface-800/40 border border-surface-800/50">
            <div class="flex items-center justify-between text-xs mb-1">
              <span class="text-surface-400">{c.compareRows[4].label}</span>
            </div>
            <div class="flex items-center justify-between gap-3 text-xs">
              <span class="text-green-400 font-semibold">{c.compareRows[4].local}</span>
              <span class="text-brand-400">{c.compareRows[4].cloud}</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
