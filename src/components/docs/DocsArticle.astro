---
import Layout from '../../layouts/Layout.astro';
import DocsHeader from './DocsHeader.astro';
import { fmt, getLangFromUrl, localizePath, pick } from '../../i18n';
import { isIterating } from '../../data/site';
import { ui } from '../../i18n/ui';

interface Entry {
  id: string;
  data: {
    title: string;
    description: string;
    group: string;
    order: number;
    source?: string;
  };
}

interface Props {
  entry: Entry;
  pages: Entry[];
  // Astro 的 Markdown 渲染组件
  Content: any;
}

const { entry, pages, Content } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = pick(ui, Astro.url);
const groups = [...new Set(pages.map((e) => e.data.group))];
const index = pages.findIndex((e) => e.id === entry.id);
const prev = index > 0 ? pages[index - 1] : null;
const next = index < pages.length - 1 ? pages[index + 1] : null;
---

<Layout title={fmt(t.docs.articleTitle, { title: entry.data.title })} description={entry.data.description}>
  <DocsHeader />

  <div class="max-w-6xl mx-auto px-6 py-10 flex flex-col lg:flex-row lg:gap-12">
    <!-- 侧栏：移动端排在正文之后 -->
    <aside class="order-2 lg:order-1 lg:w-56 shrink-0 mt-12 lg:mt-0">
      <nav class={`lg:sticky space-y-6 ${isIterating ? 'lg:top-[8.5rem]' : 'lg:top-24'}`}>
        {groups.map((group) => (
          <div>
            <div class="text-xs font-mono text-surface-500 mb-2">{group}</div>
            <ul class="space-y-1">
              {pages.filter((d) => d.data.group === group).map((doc) => (
                <li>
                  <a
                    href={localizePath(`/docs/${doc.id}`, lang)}
                    class={`block text-sm py-1 transition-colors ${
                      doc.id === entry.id
                        ? 'text-brand-400 font-semibold'
                        : 'text-surface-400 hover:text-surface-200'
                    }`}
                  >
                    {doc.data.title}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </nav>
    </aside>

    <!-- 正文 -->
    <article class="order-1 lg:order-2 min-w-0 flex-1">
      <div class="doc-body">
        <Content />
      </div>

      {entry.data.source && (
        <p class="mt-12 pt-6 border-t border-surface-800/50 text-xs text-surface-600">
          {t.docs.source}
          <a
            class="text-surface-400 hover:text-surface-200 font-mono"
            href={`https://github.com/cocosoft/Liri/blob/main/app/docs/${encodeURI(entry.data.source)}`}
            target="_blank"
            rel="noopener noreferrer"
          >
            app/docs/{entry.data.source}
          </a>
        </p>
      )}

      <div class="mt-8 flex items-center justify-between gap-4">
        {prev ? (
          <a href={localizePath(`/docs/${prev.id}`, lang)} class="text-sm text-surface-400 hover:text-brand-400 transition-colors">
            ← {prev.data.title}
          </a>
        ) : <span />}
        {next ? (
          <a href={localizePath(`/docs/${next.id}`, lang)} class="text-sm text-surface-400 hover:text-brand-400 transition-colors text-right">
            {next.data.title} →
          </a>
        ) : <span />}
      </div>
    </article>
  </div>
</Layout>
