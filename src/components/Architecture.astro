---
import { siteFacts } from '../data/site';
import { fmt, pick } from '../i18n';
import { architecture } from '../i18n/sections/architecture';

interface Props {
  /** 嵌在演进页 M4 里时去掉整节的上下留白 */
  embedded?: boolean;
}

const { embedded = false } = Astro.props;
const c = pick(architecture, Astro.url);

// 层渐变色（顺序与文案数组一致）
const colors = [
  'from-orange-500/20 to-amber-500/10',
  'from-red-500/20 to-rose-500/10',
  'from-brand-500/20 to-orange-500/10',
  'from-cyan-500/20 to-blue-500/10',
  'from-green-500/20 to-emerald-500/10',
  'from-red-500/20 to-orange-500/10',
  'from-purple-500/20 to-violet-500/10',
  'from-amber-500/20 to-yellow-500/10',
];

// 架构哲学图标（顺序与文案数组一致）
const principleIcons = ['🛡️', '🏠', '🧠', '🧬', '🔄', '🔌'];

// 数字事实统一取自 siteFacts，文案中以 {name} 占位
const nums = {
  desktopComponents: siteFacts.desktopComponents,
  desktopPages: siteFacts.desktopPages,
  channels: siteFacts.channels,
  dangerousRules: siteFacts.dangerousRules,
  injectionRules: siteFacts.injectionRules,
  shellRules: siteFacts.shellRules,
  taskTypes: siteFacts.taskTypes,
  strategies: siteFacts.agentStrategies,
  tools: siteFacts.tools,
};
---

<section id="architecture" class={`${embedded ? 'relative' : 'section-padding relative'}`}>
  <!-- 背景装饰 -->
  <div class="absolute inset-0 bg-gradient-to-b from-surface-950 via-surface-975 to-surface-950 pointer-events-none"></div>

  <div class="section-container relative z-10">
    <h2 class="text-3xl sm:text-4xl font-bold text-center mb-4">
      <span class="gradient-text">{c.title}</span>
    </h2>
    <p class="text-surface-400 text-center mb-6 max-w-3xl mx-auto">
      {c.subtitle}
    </p>

    <!-- 架构层垂直布局 -->
    <div class="max-w-5xl mx-auto space-y-2">
      {c.layers.map((layer, layerIdx) => (
        <div>
          <!-- 层卡片 -->
          <div
            class="group relative overflow-hidden rounded-2xl border border-surface-800/50 bg-surface-900/40 backdrop-blur-sm hover:border-brand-500/30 transition-all duration-500"
          >
            <!-- 渐变色标 -->
            <div class={`absolute left-0 top-0 bottom-0 w-1 bg-gradient-to-b ${colors[layerIdx]}`}></div>

            <div class="p-4 sm:p-5 pl-5 sm:pl-7">
              <!-- 层标题 -->
              <div class="flex items-center justify-between mb-2 sm:mb-3">
                <div class="flex items-center gap-2 sm:gap-3 min-w-0">
                  <span class="text-xs font-mono text-surface-500 bg-surface-800/60 px-2 py-0.5 rounded shrink-0">
                    L{layerIdx + 1}
                  </span>
                  <h3 class="text-sm sm:text-lg font-bold text-surface-100 truncate">{fmt(layer.name, nums)}</h3>
                </div>
                <span class="text-xs text-surface-500 hidden sm:block shrink-0 ml-2">{fmt(layer.subtitle, nums)}</span>
              </div>

              <!-- 层内项目（响应式网格） -->
              <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-1.5 sm:gap-2">
                {layer.items.map((item) => (
                  <div class="group/item relative p-2 sm:p-3 rounded-xl bg-surface-800/30 border border-surface-800/50 hover:border-brand-500/20 hover:bg-surface-800/50 transition-all duration-300">
                    <div class="text-xs sm:text-sm font-semibold text-surface-200 mb-0.5 sm:mb-1">{fmt(item.label, nums)}</div>
                    <div class="text-xs text-surface-500 leading-relaxed opacity-0 group-hover/item:opacity-100 transition-opacity duration-300">
                      {fmt(item.detail, nums)}
                    </div>
                  </div>
                ))}
              </div>
            </div>
          </div>

          <!-- 连接箭头 -->
          {layerIdx < c.layers.length - 1 && (
            <div class="flex justify-center py-1">
              <svg class="w-4 h-4 text-surface-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 14l-7 7m0 0l-7-7" />
              </svg>
            </div>
          )}
        </div>
      ))}
    </div>

    <!-- 架构哲学 -->
    <div class="mt-20">
      <h3 class="text-xl font-bold text-center mb-10">
        <span class="gradient-text">{c.principlesTitle}</span>
      </h3>
      <div class="grid grid-cols-2 lg:grid-cols-3 gap-4 max-w-4xl mx-auto">
        {c.principles.map((p, index) => (
          <div class="glass-card p-5 text-center hover:border-brand-500/30 transition-all duration-300">
            <div class="text-2xl mb-2">{principleIcons[index]}</div>
            <div class="text-sm font-bold text-surface-200 mb-1">{fmt(p.title, nums)}</div>
            <div class="text-xs text-surface-500">{fmt(p.desc, nums)}</div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
