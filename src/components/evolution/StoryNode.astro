---
interface NodeCopy {
  id: string;
  period: string;
  title: string;
  situation: string;
  decision: string;
  cost: string;
  result: string;
  evidence: { label: string; href: string }[];
  participate: string;
}

interface Props {
  node: NodeCopy;
  labels: {
    situation: string;
    decision: string;
    cost: string;
    result: string;
    evidence: string;
    participate: string;
  };
  index: number;
  total: number;
}

const { node, labels, index, total } = Astro.props;

const fields = [
  { key: 'situation', label: labels.situation },
  { key: 'decision', label: labels.decision },
  { key: 'cost', label: labels.cost },
  { key: 'result', label: labels.result },
] as const;
---

<article id={node.id} class="relative pl-8 sm:pl-10">
  <!-- 时间轴节点 -->
  <span class="absolute left-0 top-1.5 w-3 h-3 rounded-full bg-brand-500 ring-4 ring-brand-500/15"></span>
  {index < total - 1 && <span class="absolute left-[5px] top-5 bottom-0 w-px bg-surface-800"></span>}

  <div class="glass-card p-6 sm:p-7">
    <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1 mb-2">
      <span class="text-xs font-mono text-surface-500">{node.period}</span>
    </div>
    <h3 class="text-lg sm:text-xl font-bold text-surface-100 mb-4">{node.title}</h3>

    <dl class="space-y-3">
      {fields.map((field) => (
        <div class="sm:grid sm:grid-cols-[4.5rem_1fr] sm:gap-3">
          <dt class="text-xs font-mono text-brand-400/80 mb-1 sm:mb-0 sm:pt-0.5">{field.label}</dt>
          <dd class="text-sm text-surface-400 leading-relaxed">{node[field.key]}</dd>
        </div>
      ))}
    </dl>

    <div class="mt-5 pt-4 border-t border-surface-800/50 flex flex-wrap items-center gap-x-4 gap-y-2">
      <span class="text-xs font-mono text-surface-600">{labels.evidence}</span>
      {node.evidence.map((item) => (
        <a
          href={item.href}
          target="_blank"
          rel="noopener noreferrer"
          class="text-xs font-mono text-surface-400 hover:text-brand-400 underline underline-offset-2 transition-colors"
        >
          {item.label}
        </a>
      ))}
    </div>

    {node.participate && (
      <p class="mt-3 flex items-start gap-2 text-xs text-surface-500">
        <span class="text-brand-500 shrink-0">↳</span>
        <span><span class="text-surface-400 font-medium">{labels.participate}</span> — {node.participate}</span>
      </p>
    )}
  </div>
</article>
