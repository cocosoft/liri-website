---
import { siteFacts } from '../data/site';
import { fmt, pick } from '../i18n';
import { highlights } from '../i18n/sections/highlights';

const c = pick(highlights, Astro.url);

const params = {
  species: siteFacts.buddySpecies,
  hats: siteFacts.buddyHats,
  eyes: siteFacts.buddyEyes,
  rarities: siteFacts.buddyRarities,
};
---

<section id="more" class="section-padding relative">
  <div class="absolute inset-0 bg-gradient-to-b from-surface-950 via-surface-975 to-surface-950 pointer-events-none"></div>

  <div class="section-container relative z-10">
    <h2 class="text-3xl sm:text-4xl font-bold text-center mb-4">
      <span class="gradient-text">{c.title}</span>
    </h2>
    <p class="text-surface-400 text-center mb-12 max-w-2xl mx-auto">{c.subtitle}</p>

    <div class="grid sm:grid-cols-3 gap-4 max-w-5xl mx-auto">
      {c.cards.map((card) => (
        <div id={card.id} class="glass-card p-6 scroll-mt-28 flex flex-col">
          <div class="text-2xl mb-3">{card.icon}</div>
          <h3 class="text-base font-semibold text-surface-100 mb-2">{card.title}</h3>
          <p class="text-sm text-surface-400 leading-relaxed flex-1">{card.desc}</p>
          <div class="mt-4 flex flex-wrap gap-1.5">
            {card.chips.map((chip) => (
              <span class="px-2 py-0.5 rounded-md bg-surface-800/60 border border-surface-700/50 text-[11px] font-mono text-surface-400">
                {fmt(chip, params)}
              </span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
