---
---

<section id="ecosystem" class="section-padding relative">
  <div class="absolute inset-0 bg-gradient-to-b from-surface-950 via-surface-975 to-surface-950 pointer-events-none"></div>

  <div class="section-container relative z-10">
    <h2 class="text-3xl sm:text-4xl font-bold text-center mb-4">
      <span class="gradient-text">生态市场</span>
    </h2>
    <p class="text-surface-400 text-center mb-12 max-w-3xl mx-auto">
      插件市场 + MCP 市场 + 技能三来源 + 模板市场 = 可组合的 Liri 生态
    </p>

    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-4 max-w-5xl mx-auto">
      <!-- MCP 市场 -->
      <div class="glass-card p-6 text-center hover:border-brand-500/30 transition-all duration-500 hover:-translate-y-1">
        <div class="text-3xl mb-3">🔌</div>
        <h3 class="text-base font-bold text-surface-100 mb-2">MCP 市场</h3>
        <p class="text-xs text-surface-400 mb-4">5 个来源适配器统一检索</p>
        <div class="space-y-1.5">
          {['GitHub 来源', 'NPM 来源', '官方目录', 'Smithery 来源', '预设服务'].map((item) => (
            <div class="flex items-center gap-2 text-xs text-surface-500">
              <svg class="w-3 h-3 text-brand-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
              </svg>
              {item}
            </div>
          ))}
        </div>
      </div>

      <!-- 插件市场 -->
      <div class="glass-card p-6 text-center hover:border-brand-500/30 transition-all duration-500 hover:-translate-y-1">
        <div class="text-3xl mb-3">🧩</div>
        <h3 class="text-base font-bold text-surface-100 mb-2">插件市场</h3>
        <p class="text-xs text-surface-400 mb-4">本地 / npm / 远端目录三种来源</p>
        <div class="space-y-1.5">
          {['插件 SDK + 适配器', '生命周期与热加载', '签名校验', '配置端点 + CLI', '5 种构建变体'].map((item) => (
            <div class="flex items-center gap-2 text-xs text-surface-500">
              <svg class="w-3 h-3 text-brand-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
              </svg>
              {item}
            </div>
          ))}
        </div>
      </div>

      <!-- 技能来源 -->
      <div class="glass-card p-6 text-center hover:border-brand-500/30 transition-all duration-500 hover:-translate-y-1">
        <div class="text-3xl mb-3">⚡</div>
        <h3 class="text-base font-bold text-surface-100 mb-2">技能三来源</h3>
        <p class="text-xs text-surface-400 mb-4">内置 / 用户 / 第三方物理隔离</p>
        <div class="space-y-1.5">
          {['11 个内置技能', '用户自定义技能', 'ClawHub 第三方来源', '条件触发编排', '技能组合与匹配'].map((item) => (
            <div class="flex items-center gap-2 text-xs text-surface-500">
              <svg class="w-3 h-3 text-brand-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
              </svg>
              {item}
            </div>
          ))}
        </div>
      </div>

      <!-- 模板与协议 -->
      <div class="glass-card p-6 text-center hover:border-brand-500/30 transition-all duration-500 hover:-translate-y-1">
        <div class="text-3xl mb-3">📚</div>
        <h3 class="text-base font-bold text-surface-100 mb-2">模板与协议</h3>
        <p class="text-xs text-surface-400 mb-4">Agent 与文档模板，接入即用</p>
        <div class="space-y-1.5">
          {['Agent 模板市场', '文档模板市场', 'MCP / ACP / A2A / LSP', '插件与技能可组合', '模板参数化复用'].map((item) => (
            <div class="flex items-center gap-2 text-xs text-surface-500">
              <svg class="w-3 h-3 text-brand-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
              </svg>
              {item}
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
