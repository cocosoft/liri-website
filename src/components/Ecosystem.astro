---
import { siteFacts } from '../data/site';
import { fmt, pick } from '../i18n';
import { ecosystem } from '../i18n/sections/ecosystem';

const c = pick(ecosystem, Astro.url);
---

<section id="ecosystem" class="section-padding relative">
  <div class="absolute inset-0 bg-gradient-to-b from-surface-950 via-surface-975 to-surface-950 pointer-events-none"></div>

  <div class="section-container relative z-10">
    <h2 class="text-3xl sm:text-4xl font-bold text-center mb-4">
      <span class="gradient-text">{c.title}</span>
    </h2>
    <p class="text-surface-400 text-center mb-12 max-w-3xl mx-auto">
      {c.subtitle}
    </p>

    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-4 max-w-5xl mx-auto">
      <!-- MCP 市场 -->
      <div class="glass-card p-6 text-center hover:border-brand-500/30 transition-all duration-500 hover:-translate-y-1">
        <div class="text-3xl mb-3">🔌</div>
        <h3 class="text-base font-bold text-surface-100 mb-2">{c.mcp.title}</h3>
        <p class="text-xs text-surface-400 mb-4">{c.mcp.desc}</p>
        <div class="space-y-1.5">
          {c.mcp.items.map((item) => (
            <div class="flex items-center gap-2 text-xs text-surface-500">
              <svg class="w-3 h-3 text-brand-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
              </svg>
              {item}
            </div>
          ))}
        </div>
      </div>

      <!-- 插件市场 -->
      <div class="glass-card p-6 text-center hover:border-brand-500/30 transition-all duration-500 hover:-translate-y-1">
        <div class="text-3xl mb-3">🧩</div>
        <h3 class="text-base font-bold text-surface-100 mb-2">{c.plugins.title}</h3>
        <p class="text-xs text-surface-400 mb-4">{c.plugins.desc}</p>
        <div class="space-y-1.5">
          {c.plugins.items.map((item) => (
            <div class="flex items-center gap-2 text-xs text-surface-500">
              <svg class="w-3 h-3 text-brand-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
              </svg>
              {item}
            </div>
          ))}
        </div>
      </div>

      <!-- 技能来源 -->
      <div class="glass-card p-6 text-center hover:border-brand-500/30 transition-all duration-500 hover:-translate-y-1">
        <div class="text-3xl mb-3">⚡</div>
        <h3 class="text-base font-bold text-surface-100 mb-2">{c.skills.title}</h3>
        <p class="text-xs text-surface-400 mb-4">{c.skills.desc}</p>
        <div class="space-y-1.5">
          {c.skills.items.map((item) => (
            <div class="flex items-center gap-2 text-xs text-surface-500">
              <svg class="w-3 h-3 text-brand-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
              </svg>
              {fmt(item, { skills: siteFacts.bundledSkills })}
            </div>
          ))}
        </div>
      </div>

      <!-- 模板与协议 -->
      <div class="glass-card p-6 text-center hover:border-brand-500/30 transition-all duration-500 hover:-translate-y-1">
        <div class="text-3xl mb-3">📚</div>
        <h3 class="text-base font-bold text-surface-100 mb-2">{c.templates.title}</h3>
        <p class="text-xs text-surface-400 mb-4">{c.templates.desc}</p>
        <div class="space-y-1.5">
          {c.templates.items.map((item) => (
            <div class="flex items-center gap-2 text-xs text-surface-500">
              <svg class="w-3 h-3 text-brand-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
              </svg>
              {item}
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
