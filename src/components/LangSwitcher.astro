---
import { HTML_LANG, LANG_LABEL, LOCALES, getLangFromUrl, pick, switchLangPath } from '../i18n';
import { ui } from '../i18n/ui';

const lang = getLangFromUrl(Astro.url);
const t = pick(ui, Astro.url);
const short = lang === 'zh' ? '中文' : lang.toUpperCase();
---

<!-- 语言切换：下拉列出全部语言，指向当前页面的对应译文 -->
<details class="relative" data-lang-switcher>
  <summary
    class="list-none cursor-pointer inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg border border-surface-800/60 text-surface-400 hover:text-surface-100 hover:border-surface-600 transition-colors text-xs font-medium select-none [&::-webkit-details-marker]:hidden"
    aria-label={t.lang.label}
  >
    <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
      <path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9 9 0 100-18 9 9 0 000 18z" />
      <path stroke-linecap="round" stroke-linejoin="round" d="M3.6 9h16.8M3.6 15h16.8" />
      <path stroke-linecap="round" stroke-linejoin="round" d="M12 3c2.5 2.4 3.9 5.5 3.9 9s-1.4 6.6-3.9 9c-2.5-2.4-3.9-5.5-3.9-9S9.5 5.4 12 3z" />
    </svg>
    <span class="font-mono">{short}</span>
  </summary>

  <div
    class="absolute end-0 mt-2 w-44 max-h-80 overflow-y-auto rounded-xl border border-surface-800/60 bg-surface-975/95 backdrop-blur-xl py-1 shadow-2xl"
  >
    {LOCALES.map((locale) => (
      <a
        href={switchLangPath(Astro.url, locale)}
        hreflang={HTML_LANG[locale]}
        lang={HTML_LANG[locale]}
        aria-current={locale === lang ? 'true' : undefined}
        class={`block px-3.5 py-1.5 text-xs transition-colors ${
          locale === lang
            ? 'text-brand-400 font-semibold'
            : 'text-surface-400 hover:text-surface-100 hover:bg-surface-800/50'
        }`}
      >
        {LANG_LABEL[locale]}
      </a>
    ))}
  </div>
</details>

<script>
  // 点空白处 / 按 Esc 收起下拉
  document.querySelectorAll('[data-lang-switcher]').forEach((el) => {
    document.addEventListener('click', (event) => {
      if (!el.contains(event.target as Node)) el.removeAttribute('open');
    });
    document.addEventListener('keydown', (event) => {
      if ((event as KeyboardEvent).key === 'Escape') el.removeAttribute('open');
    });
  });
</script>
