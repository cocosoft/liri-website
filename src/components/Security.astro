---
import { siteFacts } from '../data/site';
import { fmt, pick } from '../i18n';
import { security } from '../i18n/sections/security';

const c = pick(security, Astro.url);

// 层样式元数据（顺序与文案数组一致）
const layerMeta = [
  { tagClass: 'text-rose-400 bg-rose-500/10 border-rose-500/20', icon: '🦀', color: '#F43F5E' },
  { tagClass: 'text-orange-400 bg-orange-500/10 border-orange-500/20', icon: '🔍', color: '#F97316' },
  { tagClass: 'text-amber-400 bg-amber-500/10 border-amber-500/20', icon: '⚙️', color: '#F59E0B' },
  { tagClass: 'text-emerald-400 bg-emerald-500/10 border-emerald-500/20', icon: '🤖', color: '#10B981' },
  { tagClass: 'text-brand-400 bg-brand-500/10 border-brand-500/20', icon: '🔒', color: '#FF5A36' },
];

// 安全防护数据（顺序与文案数组一致，数字均可在源码中复核）
const protectionValues = [
  siteFacts.dangerousRules,
  siteFacts.injectionRules,
  6,
  siteFacts.sandboxFiles,
];

// 数字事实统一取自 siteFacts，文案中以 {name} 占位
const nums = {
  dangerousRules: siteFacts.dangerousRules,
  injectionRules: siteFacts.injectionRules,
  shellRules: siteFacts.shellRules,
};
---

<section id="security" class="section-padding relative overflow-hidden">
  <!-- 背景 -->
  <div class="absolute inset-0 bg-gradient-to-b from-surface-950 via-surface-975 to-surface-950 pointer-events-none"></div>
  <div class="absolute top-1/4 left-1/2 -translate-x-1/2 w-[600px] h-[600px] bg-rose-500/3 blur-3xl rounded-full pointer-events-none"></div>

  <div class="section-container relative z-10">
    <h2 class="text-3xl sm:text-4xl font-bold text-center mb-4">
      <span class="gradient-text">{c.title}</span>
    </h2>
    <p class="text-surface-400 text-center mb-16 max-w-3xl mx-auto">
      {c.subtitle}
    </p>

    <!-- 五层交互式安全演示 -->
    <div class="max-w-4xl mx-auto">
      {c.layers.map((layer, index) => (
        <div class="group">
          <details class="glass-card border border-surface-800/50 open:border-opacity-60 transition-all duration-500 overflow-hidden"
            style={`animation: fade-in-up .5s ease-out ${index * 0.12}s both;`}>
            <summary class="list-none p-5 sm:p-6 cursor-pointer select-none group-open:pb-3 transition-all duration-300">
              <div class="flex items-center gap-4">
                <!-- 图标 -->
                <div class="text-2xl w-12 h-12 flex items-center justify-center rounded-xl bg-surface-800/50 shrink-0
                  group-open:scale-110 transition-all duration-300"
                  style={`box-shadow: 0 0 20px ${layerMeta[index].color}20;`}>
                  {layerMeta[index].icon}
                </div>

                <!-- 内容 -->
                <div class="flex-1 min-w-0">
                  <div class="flex items-center gap-3 mb-1">
                    <h3 class="text-base font-bold text-surface-100">{layer.title}</h3>
                    <span class={`px-2.5 py-0.5 rounded-full text-xs font-mono border ${layerMeta[index].tagClass}`}>
                      {layer.tag}
                    </span>
                  </div>
                  <p class="text-surface-400 text-sm leading-relaxed">{fmt(layer.short, nums)}</p>
                </div>

                <!-- 编号 + 展开指示 -->
                <div class="flex items-center gap-3 shrink-0">
                  <span class="text-lg font-mono font-bold opacity-20 hidden sm:block"
                    style={`color: ${layerMeta[index].color};`}>#{index + 1}</span>
                  <svg class="w-4 h-4 text-surface-500 group-open:rotate-180 transition-transform duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                  </svg>
                </div>
              </div>
            </summary>

            <!-- 展开详情 -->
            <div class="px-5 sm:px-6 pb-5 sm:pb-6 pt-2 border-t border-surface-800/30">
              <ul class="grid sm:grid-cols-2 gap-2">
                {layer.details.map((detail) => (
                  <li class="flex items-center gap-2 text-sm text-surface-400 p-2 rounded-lg bg-surface-800/30">
                    <svg class="w-3.5 h-3.5 shrink-0" style={`color: ${layerMeta[index].color};`} fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                    </svg>
                    {fmt(detail, nums)}
                  </li>
                ))}
              </ul>
            </div>
          </details>

          <!-- 连接箭头 -->
          {index < c.layers.length - 1 && (
            <div class="flex justify-center py-0.5">
              <svg class="w-4 h-4 text-surface-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
              </svg>
            </div>
          )}
        </div>
      ))}
    </div>

    <!-- 安全防护数据 -->
    <div class="mt-16 max-w-4xl mx-auto">
      <h3 class="text-sm font-mono text-surface-500 text-center mb-5">{c.protectionsTitle}</h3>
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
        {c.protections.map((p, index) => (
          <div class="glass-card p-5 text-center hover:border-brand-500/30 transition-all duration-300">
            <div class="text-2xl font-bold gradient-text mb-1">{fmt(p.value, { n: protectionValues[index] })}</div>
            <div class="text-surface-200 text-sm font-semibold mb-1">{p.label}</div>
            <div class="text-surface-500 text-xs">{p.desc}</div>
          </div>
        ))}
      </div>
    </div>

    <!-- 一句话总结 -->
    <div class="text-center mt-8">
      <p class="text-surface-500 text-sm font-mono">
        {c.summary}
      </p>
    </div>
  </div>
</section>
