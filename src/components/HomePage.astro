---
import Layout from '../layouts/Layout.astro';
import SiteNav from './SiteNav.astro';
import Hero from './Hero.astro';
import EvolutionTeaser from './EvolutionTeaser.astro';
import About from './About.astro';
import Capabilities from './Capabilities.astro';
import ArchitectureSummary from './ArchitectureSummary.astro';
import Security from './Security.astro';
import SmartRouter from './SmartRouter.astro';
import VoiceInteraction from './VoiceInteraction.astro';
import BrainSection from './BrainSection.astro';
import DesktopClient from './DesktopClient.astro';
import ChannelWall from './ChannelWall.astro';
import Ecosystem from './Ecosystem.astro';
import MoreHighlights from './MoreHighlights.astro';
import Limitations from './Limitations.astro';
import QuickStart from './QuickStart.astro';
import Community from './Community.astro';
import Footer from './Footer.astro';
import { pick } from '../i18n';
import { ui } from '../i18n/ui';

const t = pick(ui, Astro.url);
---

<Layout title={t.meta.homeTitle} description={t.meta.homeDescription}>
  <SiteNav />

  <main>
    <Hero />
    <EvolutionTeaser />
    <About />
    <Capabilities />
    <ArchitectureSummary />
    <Security />
    <SmartRouter />
    <VoiceInteraction />
    <BrainSection />
    <DesktopClient />
    <ChannelWall />
    <Ecosystem />
    <MoreHighlights />
    <Limitations limit={3} />
    <QuickStart />
    <Community />
  </main>

  <Footer />
</Layout>
