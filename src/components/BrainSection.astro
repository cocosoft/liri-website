---
import { pick } from '../i18n';
import { brainSection } from '../i18n/sections/brainSection';

const c = pick(brainSection, Astro.url);
---

<section id="brain" class="section-padding relative overflow-hidden">
  <!-- 背景装饰 -->
  <div class="absolute inset-0 bg-gradient-to-b from-surface-950 via-surface-975 to-surface-950 pointer-events-none"></div>
  <div class="absolute top-1/4 right-0 w-96 h-96 bg-cyan-500/5 blur-3xl rounded-full pointer-events-none"></div>

  <div class="section-container relative z-10">
    <h2 class="text-3xl sm:text-4xl font-bold text-center mb-4">
      <span class="gradient-text">{c.title}</span>
    </h2>
    <p class="text-surface-400 text-center mb-16 max-w-3xl mx-auto">
      {c.subtitle}
    </p>

    <!-- 三层流水线 -->
    <div class="max-w-5xl mx-auto">
      <!-- 第一层：知识库 -->
      <div class="glass-card p-6 text-center group hover:border-cyan-500/30 transition-all duration-500">
        <div class="flex items-center justify-center gap-2 mb-3">
          <span class="px-3 py-1 rounded-full text-xs font-mono bg-cyan-500/10 text-cyan-400 border border-cyan-500/20">
            {c.layers[0].badge}
          </span>
        </div>
        <h3 class="text-xl font-bold text-surface-100 mb-2">{c.layers[0].title}</h3>
        <p class="text-surface-400 text-sm mb-4">{c.layers[0].desc}</p>
        <div class="flex flex-wrap justify-center gap-2">
          <span class="px-3 py-1 rounded-lg bg-surface-800/60 text-surface-300 text-xs font-mono border border-surface-700/50">{c.layers[0].tags[0]}</span>
          <span class="px-3 py-1 rounded-lg bg-surface-800/60 text-surface-300 text-xs font-mono border border-surface-700/50">{c.layers[0].tags[1]}</span>
          <span class="px-3 py-1 rounded-lg bg-surface-800/60 text-surface-300 text-xs font-mono border border-surface-700/50">{c.layers[0].tags[2]}</span>
          <span class="px-3 py-1 rounded-lg bg-surface-800/60 text-surface-300 text-xs font-mono border border-surface-700/50">{c.layers[0].tags[3]}</span>
          <span class="px-3 py-1 rounded-lg bg-surface-800/60 text-surface-300 text-xs font-mono border border-surface-700/50">{c.layers[0].tags[4]}</span>
        </div>
      </div>

      <!-- 连接箭头 -->
      <div class="flex justify-center py-2">
        <svg class="w-5 h-5 text-cyan-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19 14l-7 7m0 0l-7-7" />
        </svg>
      </div>

      <!-- 第二层：记忆系统 -->
      <div class="glass-card p-6 text-center group hover:border-brand-500/30 transition-all duration-500">
        <div class="flex items-center justify-center gap-2 mb-3">
          <span class="px-3 py-1 rounded-full text-xs font-mono bg-brand-500/10 text-brand-400 border border-brand-500/20">
            {c.layers[1].badge}
          </span>
        </div>
        <h3 class="text-xl font-bold text-surface-100 mb-2">{c.layers[1].title}</h3>
        <p class="text-surface-400 text-sm mb-4">{c.layers[1].desc}</p>
        <div class="flex flex-wrap justify-center gap-2">
          <span class="px-3 py-1 rounded-lg bg-surface-800/60 text-surface-300 text-xs font-mono border border-surface-700/50">{c.layers[1].tags[0]}</span>
          <span class="px-3 py-1 rounded-lg bg-surface-800/60 text-surface-300 text-xs font-mono border border-surface-700/50">{c.layers[1].tags[1]}</span>
          <span class="px-3 py-1 rounded-lg bg-surface-800/60 text-surface-300 text-xs font-mono border border-surface-700/50">{c.layers[1].tags[2]}</span>
          <span class="px-3 py-1 rounded-lg bg-surface-800/60 text-surface-300 text-xs font-mono border border-surface-700/50">{c.layers[1].tags[3]}</span>
          <span class="px-3 py-1 rounded-lg bg-surface-800/60 text-surface-300 text-xs font-mono border border-surface-700/50">{c.layers[1].tags[4]}</span>
        </div>
      </div>

      <!-- 连接箭头 -->
      <div class="flex justify-center py-2">
        <svg class="w-5 h-5 text-brand-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19 14l-7 7m0 0l-7-7" />
        </svg>
      </div>

      <!-- 第三层：会话事件 -->
      <div class="glass-card p-6 text-center group hover:border-purple-500/30 transition-all duration-500">
        <div class="flex items-center justify-center gap-2 mb-3">
          <span class="px-3 py-1 rounded-full text-xs font-mono bg-purple-500/10 text-purple-400 border border-purple-500/20">
            {c.layers[2].badge}
          </span>
        </div>
        <h3 class="text-xl font-bold text-surface-100 mb-2">{c.layers[2].title}</h3>
        <p class="text-surface-400 text-sm mb-4">{c.layers[2].desc}</p>
        <div class="flex flex-wrap justify-center gap-2">
          <span class="px-3 py-1 rounded-lg bg-surface-800/60 text-surface-300 text-xs font-mono border border-surface-700/50">{c.layers[2].tags[0]}</span>
          <span class="px-3 py-1 rounded-lg bg-surface-800/60 text-surface-300 text-xs font-mono border border-surface-700/50">{c.layers[2].tags[1]}</span>
          <span class="px-3 py-1 rounded-lg bg-surface-800/60 text-surface-300 text-xs font-mono border border-surface-700/50">{c.layers[2].tags[2]}</span>
          <span class="px-3 py-1 rounded-lg bg-surface-800/60 text-surface-300 text-xs font-mono border border-surface-700/50">{c.layers[2].tags[3]}</span>
          <span class="px-3 py-1 rounded-lg bg-surface-800/60 text-surface-300 text-xs font-mono border border-surface-700/50">{c.layers[2].tags[4]}</span>
        </div>
      </div>
    </div>

    <!-- 分隔：整理与治理 -->
    <div class="mt-24">
      <h2 class="text-3xl sm:text-4xl font-bold text-center mb-4">
        <span class="gradient-text">{c.governTitle}</span>
      </h2>
      <p class="text-surface-400 text-center mb-16 max-w-3xl mx-auto">
        {c.governSubtitle}
      </p>

      <!-- DreamEngine 五阶段 -->
      <div class="max-w-5xl mx-auto mb-12">
        <h3 class="text-sm font-mono text-surface-500 text-center mb-5">{c.dreamHeading}</h3>
        <div class="grid grid-cols-2 lg:grid-cols-5 gap-3">
          <div class="glass-card p-4 text-center hover:border-cyan-500/30 transition-all duration-300">
            <div class="text-xs font-mono text-cyan-400 mb-2">01 Gather</div>
            <div class="text-sm text-surface-300 font-semibold">{c.dreamStages[0].name}</div>
            <div class="text-xs text-surface-500 mt-1">{c.dreamStages[0].desc}</div>
          </div>
          <div class="glass-card p-4 text-center hover:border-brand-500/30 transition-all duration-300">
            <div class="text-xs font-mono text-brand-400 mb-2">02 Analyze</div>
            <div class="text-sm text-surface-300 font-semibold">{c.dreamStages[1].name}</div>
            <div class="text-xs text-surface-500 mt-1">{c.dreamStages[1].desc}</div>
          </div>
          <div class="glass-card p-4 text-center hover:border-purple-500/30 transition-all duration-300">
            <div class="text-xs font-mono text-purple-400 mb-2">03 Generate</div>
            <div class="text-sm text-surface-300 font-semibold">{c.dreamStages[2].name}</div>
            <div class="text-xs text-surface-500 mt-1">{c.dreamStages[2].desc}</div>
          </div>
          <div class="glass-card p-4 text-center hover:border-amber-500/30 transition-all duration-300">
            <div class="text-xs font-mono text-amber-400 mb-2">04 Write</div>
            <div class="text-sm text-surface-300 font-semibold">{c.dreamStages[3].name}</div>
            <div class="text-xs text-surface-500 mt-1">{c.dreamStages[3].desc}</div>
          </div>
          <div class="glass-card p-4 text-center hover:border-green-500/30 transition-all duration-300">
            <div class="text-xs font-mono text-green-400 mb-2">05 Index</div>
            <div class="text-sm text-surface-300 font-semibold">{c.dreamStages[4].name}</div>
            <div class="text-xs text-surface-500 mt-1">{c.dreamStages[4].desc}</div>
          </div>
        </div>
      </div>

      <!-- 上下文治理 -->
      <div class="max-w-3xl mx-auto glass-card p-8 text-center border-amber-500/20">
        <div class="text-4xl mb-4">🧠</div>
        <h3 class="text-xl font-bold text-surface-100 mb-3">{c.contextTitle}</h3>
        <p class="text-surface-400 text-sm mb-6">
          {c.contextBody}
        </p>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          <div class="p-4 rounded-xl bg-surface-800/40 border border-surface-800/50">
            <div class="text-sm font-semibold text-surface-200 mb-1">{c.contextCards[0].title}</div>
            <div class="text-xs text-surface-500">{c.contextCards[0].desc}</div>
          </div>
          <div class="p-4 rounded-xl bg-surface-800/40 border border-surface-800/50">
            <div class="text-sm font-semibold text-surface-200 mb-1">{c.contextCards[1].title}</div>
            <div class="text-xs text-surface-500">{c.contextCards[1].desc}</div>
          </div>
          <div class="p-4 rounded-xl bg-surface-800/40 border border-surface-800/50">
            <div class="text-sm font-semibold text-surface-200 mb-1">{c.contextCards[2].title}</div>
            <div class="text-xs text-surface-500">{c.contextCards[2].desc}</div>
          </div>
        </div>
      </div>

      <!-- PDCA 自迭代 -->
      <div class="max-w-3xl mx-auto mt-6 glass-card p-8 text-center border-green-500/20">
        <div class="text-4xl mb-4">🔄</div>
        <h3 class="text-xl font-bold text-surface-100 mb-3">{c.pdcaTitle}</h3>
        <p class="text-surface-400 text-sm mb-6">
          {c.pdcaBody}
        </p>
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
          <div class="p-3 rounded-xl bg-green-500/10 border border-green-500/20">
            <div class="text-sm font-semibold text-green-300">{c.pdcaSteps[0].step}</div>
            <div class="text-xs text-surface-500 mt-1">{c.pdcaSteps[0].desc}</div>
          </div>
          <div class="p-3 rounded-xl bg-brand-500/10 border border-brand-500/20">
            <div class="text-sm font-semibold text-brand-300">{c.pdcaSteps[1].step}</div>
            <div class="text-xs text-surface-500 mt-1">{c.pdcaSteps[1].desc}</div>
          </div>
          <div class="p-3 rounded-xl bg-amber-500/10 border border-amber-500/20">
            <div class="text-sm font-semibold text-amber-300">{c.pdcaSteps[2].step}</div>
            <div class="text-xs text-surface-500 mt-1">{c.pdcaSteps[2].desc}</div>
          </div>
          <div class="p-3 rounded-xl bg-cyan-500/10 border border-cyan-500/20">
            <div class="text-sm font-semibold text-cyan-300">{c.pdcaSteps[3].step}</div>
            <div class="text-xs text-surface-500 mt-1">{c.pdcaSteps[3].desc}</div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
