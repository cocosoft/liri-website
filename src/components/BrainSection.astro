---
---

<section id="brain" class="section-padding relative overflow-hidden">
  <!-- 背景装饰 -->
  <div class="absolute inset-0 bg-gradient-to-b from-surface-950 via-surface-975 to-surface-950 pointer-events-none"></div>
  <div class="absolute top-1/4 right-0 w-96 h-96 bg-cyan-500/5 blur-3xl rounded-full pointer-events-none"></div>

  <div class="section-container relative z-10">
    <h2 class="text-3xl sm:text-4xl font-bold text-center mb-4">
      <span class="gradient-text">外脑系统</span>
    </h2>
    <p class="text-surface-400 text-center mb-16 max-w-3xl mx-auto">
      知识库 → 记忆 → 会话事件：三段可检索上下文，都保存在本机
    </p>

    <!-- 三层流水线 -->
    <div class="max-w-5xl mx-auto">
      <!-- 第一层：知识库 -->
      <div class="glass-card p-6 text-center group hover:border-cyan-500/30 transition-all duration-500">
        <div class="flex items-center justify-center gap-2 mb-3">
          <span class="px-3 py-1 rounded-full text-xs font-mono bg-cyan-500/10 text-cyan-400 border border-cyan-500/20">
            第1层：知识库
          </span>
        </div>
        <h3 class="text-xl font-bold text-surface-100 mb-2">知识库</h3>
        <p class="text-surface-400 text-sm mb-4">Markdown 落盘 + 语义索引，检索结果带来源标注</p>
        <div class="flex flex-wrap justify-center gap-2">
          <span class="px-3 py-1 rounded-lg bg-surface-800/60 text-surface-300 text-xs font-mono border border-surface-700/50">Markdown 落盘</span>
          <span class="px-3 py-1 rounded-lg bg-surface-800/60 text-surface-300 text-xs font-mono border border-surface-700/50">语义索引 JSONL</span>
          <span class="px-3 py-1 rounded-lg bg-surface-800/60 text-surface-300 text-xs font-mono border border-surface-700/50">关键词检索</span>
          <span class="px-3 py-1 rounded-lg bg-surface-800/60 text-surface-300 text-xs font-mono border border-surface-700/50">向量检索</span>
          <span class="px-3 py-1 rounded-lg bg-surface-800/60 text-surface-300 text-xs font-mono border border-surface-700/50">RRF 融合</span>
        </div>
      </div>

      <!-- 连接箭头 -->
      <div class="flex justify-center py-2">
        <svg class="w-5 h-5 text-cyan-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19 14l-7 7m0 0l-7-7" />
        </svg>
      </div>

      <!-- 第二层：记忆系统 -->
      <div class="glass-card p-6 text-center group hover:border-brand-500/30 transition-all duration-500">
        <div class="flex items-center justify-center gap-2 mb-3">
          <span class="px-3 py-1 rounded-full text-xs font-mono bg-brand-500/10 text-brand-400 border border-brand-500/20">
            第2层：记忆
          </span>
        </div>
        <h3 class="text-xl font-bold text-surface-100 mb-2">记忆系统</h3>
        <p class="text-surface-400 text-sm mb-4">分层记忆 + SQLite 向量表，按相关性加权召回</p>
        <div class="flex flex-wrap justify-center gap-2">
          <span class="px-3 py-1 rounded-lg bg-surface-800/60 text-surface-300 text-xs font-mono border border-surface-700/50">分层记忆</span>
          <span class="px-3 py-1 rounded-lg bg-surface-800/60 text-surface-300 text-xs font-mono border border-surface-700/50">memory_vectors</span>
          <span class="px-3 py-1 rounded-lg bg-surface-800/60 text-surface-300 text-xs font-mono border border-surface-700/50">相关性加权</span>
          <span class="px-3 py-1 rounded-lg bg-surface-800/60 text-surface-300 text-xs font-mono border border-surface-700/50">记忆清洗</span>
          <span class="px-3 py-1 rounded-lg bg-surface-800/60 text-surface-300 text-xs font-mono border border-surface-700/50">上下文注入</span>
        </div>
      </div>

      <!-- 连接箭头 -->
      <div class="flex justify-center py-2">
        <svg class="w-5 h-5 text-brand-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19 14l-7 7m0 0l-7-7" />
        </svg>
      </div>

      <!-- 第三层：会话事件 -->
      <div class="glass-card p-6 text-center group hover:border-purple-500/30 transition-all duration-500">
        <div class="flex items-center justify-center gap-2 mb-3">
          <span class="px-3 py-1 rounded-full text-xs font-mono bg-purple-500/10 text-purple-400 border border-purple-500/20">
            第3层：事实源
          </span>
        </div>
        <h3 class="text-xl font-bold text-surface-100 mb-2">会话事件日志</h3>
        <p class="text-surface-400 text-sm mb-4">进入模型请求的内容都会落为会话事件，可回放</p>
        <div class="flex flex-wrap justify-center gap-2">
          <span class="px-3 py-1 rounded-lg bg-surface-800/60 text-surface-300 text-xs font-mono border border-surface-700/50">events.jsonl 追加</span>
          <span class="px-3 py-1 rounded-lg bg-surface-800/60 text-surface-300 text-xs font-mono border border-surface-700/50">写前落盘</span>
          <span class="px-3 py-1 rounded-lg bg-surface-800/60 text-surface-300 text-xs font-mono border border-surface-700/50">会话回放</span>
          <span class="px-3 py-1 rounded-lg bg-surface-800/60 text-surface-300 text-xs font-mono border border-surface-700/50">审计可追溯</span>
          <span class="px-3 py-1 rounded-lg bg-surface-800/60 text-surface-300 text-xs font-mono border border-surface-700/50">编译期强制登记</span>
        </div>
      </div>
    </div>

    <!-- 分隔：整理与治理 -->
    <div class="mt-24">
      <h2 class="text-3xl sm:text-4xl font-bold text-center mb-4">
        <span class="gradient-text">整理与治理</span>
      </h2>
      <p class="text-surface-400 text-center mb-16 max-w-3xl mx-auto">
        空闲时整理知识，超窗时压缩上下文 —— 两条真实存在的后台管线
      </p>

      <!-- DreamEngine 五阶段 -->
      <div class="max-w-5xl mx-auto mb-12">
        <h3 class="text-sm font-mono text-surface-500 text-center mb-5">DreamEngine 五阶段管线</h3>
        <div class="grid grid-cols-2 lg:grid-cols-5 gap-3">
          <div class="glass-card p-4 text-center hover:border-cyan-500/30 transition-all duration-300">
            <div class="text-xs font-mono text-cyan-400 mb-2">01 Gather</div>
            <div class="text-sm text-surface-300 font-semibold">采集</div>
            <div class="text-xs text-surface-500 mt-1">汇总待整理的会话与文档</div>
          </div>
          <div class="glass-card p-4 text-center hover:border-brand-500/30 transition-all duration-300">
            <div class="text-xs font-mono text-brand-400 mb-2">02 Analyze</div>
            <div class="text-sm text-surface-300 font-semibold">分析</div>
            <div class="text-xs text-surface-500 mt-1">抽取主题与可复用结论</div>
          </div>
          <div class="glass-card p-4 text-center hover:border-purple-500/30 transition-all duration-300">
            <div class="text-xs font-mono text-purple-400 mb-2">03 Generate</div>
            <div class="text-sm text-surface-300 font-semibold">生成</div>
            <div class="text-xs text-surface-500 mt-1">产出面向上层的笔记</div>
          </div>
          <div class="glass-card p-4 text-center hover:border-amber-500/30 transition-all duration-300">
            <div class="text-xs font-mono text-amber-400 mb-2">04 Write</div>
            <div class="text-sm text-surface-300 font-semibold">写入</div>
            <div class="text-xs text-surface-500 mt-1">落盘到知识库与记忆</div>
          </div>
          <div class="glass-card p-4 text-center hover:border-green-500/30 transition-all duration-300">
            <div class="text-xs font-mono text-green-400 mb-2">05 Index</div>
            <div class="text-sm text-surface-300 font-semibold">索引</div>
            <div class="text-xs text-surface-500 mt-1">重建向量与关键词索引</div>
          </div>
        </div>
      </div>

      <!-- 上下文治理 -->
      <div class="max-w-3xl mx-auto glass-card p-8 text-center border-amber-500/20">
        <div class="text-4xl mb-4">🧠</div>
        <h3 class="text-xl font-bold text-surface-100 mb-3">上下文分层治理</h3>
        <p class="text-surface-400 text-sm mb-6">
          超窗的长会话先丢头部旧轮次，构建期内存占用从 O(全量) 降到 O(窗口)；
          切窗时保留「原文可取回」提示，需要细节再按页读回；再按 token 水位自动压缩。
        </p>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          <div class="p-4 rounded-xl bg-surface-800/40 border border-surface-800/50">
            <div class="text-sm font-semibold text-surface-200 mb-1">分层切窗</div>
            <div class="text-xs text-surface-500">超窗先裁旧轮次</div>
          </div>
          <div class="p-4 rounded-xl bg-surface-800/40 border border-surface-800/50">
            <div class="text-sm font-semibold text-surface-200 mb-1">按需取回</div>
            <div class="text-xs text-surface-500">原文可分段读回</div>
          </div>
          <div class="p-4 rounded-xl bg-surface-800/40 border border-surface-800/50">
            <div class="text-sm font-semibold text-surface-200 mb-1">三级压缩</div>
            <div class="text-xs text-surface-500">Tier1/2 同步 + Tier3 后台</div>
          </div>
        </div>
      </div>

      <!-- PDCA 自迭代 -->
      <div class="max-w-3xl mx-auto mt-6 glass-card p-8 text-center border-green-500/20">
        <div class="text-4xl mb-4">🔄</div>
        <h3 class="text-xl font-bold text-surface-100 mb-3">PDCA 自迭代闭环</h3>
        <p class="text-surface-400 text-sm mb-6">
          对于长程任务，Liri 自动执行 Plan-Do-Check-Act 循环：
          分解任务 → 执行步骤 → 评审结果 → 修正方案，直至完成或触发终止条件。
        </p>
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
          <div class="p-3 rounded-xl bg-green-500/10 border border-green-500/20">
            <div class="text-sm font-semibold text-green-300">Plan</div>
            <div class="text-xs text-surface-500 mt-1">自动分解</div>
          </div>
          <div class="p-3 rounded-xl bg-brand-500/10 border border-brand-500/20">
            <div class="text-sm font-semibold text-brand-300">Do</div>
            <div class="text-xs text-surface-500 mt-1">逐步执行</div>
          </div>
          <div class="p-3 rounded-xl bg-amber-500/10 border border-amber-500/20">
            <div class="text-sm font-semibold text-amber-300">Check</div>
            <div class="text-xs text-surface-500 mt-1">自动评审</div>
          </div>
          <div class="p-3 rounded-xl bg-cyan-500/10 border border-cyan-500/20">
            <div class="text-sm font-semibold text-cyan-300">Act</div>
            <div class="text-xs text-surface-500 mt-1">自动修正</div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
