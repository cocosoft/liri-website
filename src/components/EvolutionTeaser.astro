---
import { getLangFromUrl, localizePath, pick } from '../i18n';
import { evolution } from '../i18n/sections/evolution';

const lang = getLangFromUrl(Astro.url);
const c = pick(evolution, Astro.url).teaser;
---

<section class="section-padding relative">
  <div class="section-container">
    <div class="max-w-3xl mx-auto glass-card p-8 sm:p-10">
      <span class="inline-flex items-center gap-2 text-xs font-mono text-brand-400 mb-4">
        <span class="w-1.5 h-1.5 rounded-full bg-brand-400"></span>
        BUILD LOG
      </span>

      <h2 class="text-2xl sm:text-3xl font-bold text-surface-100 mb-5">{c.title}</h2>

      <div class="space-y-4 text-surface-400 leading-relaxed">
        {c.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
      </div>

      <div class="mt-6 flex flex-wrap items-center gap-x-4 gap-y-2">
        {c.stats.map((stat) => (
          <span class="px-2.5 py-1 rounded-lg bg-surface-800/60 border border-surface-700/50 text-xs font-mono text-surface-400">
            {stat}
          </span>
        ))}
      </div>

      <a
        href={localizePath('/evolution', lang)}
        class="mt-7 inline-flex items-center gap-2 text-sm font-semibold text-brand-400 hover:text-brand-300 transition-colors"
      >
        {c.cta}
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
        </svg>
      </a>
    </div>
  </div>
</section>
