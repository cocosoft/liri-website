---
import { siteFacts } from '../data/site';
import { fmt, getLangFromUrl, localizePath, num, pick } from '../i18n';
import { ui } from '../i18n/ui';
import { limitationStatusClass, limitations } from '../i18n/sections/limitations';

interface Props {
  /** 只展示前 N 条（首页用 3 条，完整清单在 /status） */
  limit?: number;
}

const { limit } = Astro.props;
const c = pick(limitations, Astro.url);
const t = pick(ui, Astro.url);
const lang = getLangFromUrl(Astro.url);
const items = limit ? c.items.slice(0, limit) : c.items;

const itemParams = {
  securityLayers: siteFacts.securityLayers,
  sandboxFiles: siteFacts.sandboxFiles,
  desktopComponents: num(siteFacts.desktopComponents),
  desktopPages: siteFacts.desktopPages,
};
---

<section id="limitations" class="section-padding relative">
  <div class="section-container">
    <h2 class="text-3xl sm:text-4xl font-bold text-center mb-4">
      <span class="gradient-text">{c.title}</span>
    </h2>
    <p class="text-surface-400 text-center mb-12 max-w-2xl mx-auto">
      {c.subtitle}
    </p>

    <div class="grid sm:grid-cols-2 gap-4 max-w-4xl mx-auto">
      {items.map((item) => (
        <div class="glass-card p-6">
          <div class="flex items-start justify-between gap-3 mb-3">
            <h3 class="text-base font-semibold text-surface-100 leading-snug">{item.title}</h3>
            <span class={`shrink-0 inline-flex items-center whitespace-nowrap px-2 py-0.5 rounded-full border text-[11px] font-medium ${limitationStatusClass[item.status as keyof typeof c.statuses]}`}>
              {c.statuses[item.status as keyof typeof c.statuses]}
            </span>
          </div>
          <p class="text-surface-400 text-sm leading-relaxed">
            {fmt(item.desc, itemParams)}
          </p>
        </div>
      ))}
    </div>

    <div class="text-center mt-10 flex flex-col sm:flex-row items-center justify-center gap-4">
      {limit && (
        <a
          href={localizePath('/status', lang)}
          class="inline-flex items-center gap-1.5 text-sm font-medium text-brand-400 hover:text-brand-300 transition-colors"
        >
          {t.common.fullStatus}
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
          </svg>
        </a>
      )}
      <a
        href="https://github.com/cocosoft/Liri/issues"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 text-sm text-surface-400 hover:text-brand-400 transition-colors"
      >
        {c.cta}
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
        </svg>
      </a>
    </div>
  </div>
</section>
