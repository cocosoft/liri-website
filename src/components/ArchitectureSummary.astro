---
import { getLangFromUrl, localizePath, pick } from '../i18n';
import { architecture } from '../i18n/sections/architecture';

const lang = getLangFromUrl(Astro.url);
const c = pick(architecture, Astro.url).summary;
---

<section id="architecture" class="section-padding relative">
  <div class="section-container">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-3xl sm:text-4xl font-bold text-center mb-4">
        <span class="gradient-text">{c.title}</span>
      </h2>
      <p class="text-surface-400 text-center mb-12 max-w-2xl mx-auto">{c.subtitle}</p>

      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {c.pillars.map((pillar) => (
          <div class="glass-card p-5">
            <h3 class="text-sm font-bold text-brand-300 mb-2">{pillar.title}</h3>
            <p class="text-xs text-surface-400 leading-relaxed">{pillar.desc}</p>
          </div>
        ))}
      </div>

      <div class="text-center mt-8">
        <a
          href={`${localizePath('/evolution', lang)}#model`}
          class="inline-flex items-center gap-2 text-sm font-medium text-brand-400 hover:text-brand-300 transition-colors"
        >
          {c.link}
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
          </svg>
        </a>
      </div>
    </div>
  </div>
</section>
